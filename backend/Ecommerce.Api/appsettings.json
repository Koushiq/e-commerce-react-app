{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ecommerce.db",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "UseRedis": false
  },
  "JwtSettings": {
    "SecretKey": "SuperSecretKeyForEcommerceApp2026!WithPlentyOfEntropyAndBits1234567890",
    "Issuer": "EcommerceApi",
    "Audience": "EcommerceClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PaymentGateways": {
    "bKash": {
      "AppKey": "sandbox-bkash-app-key",
      "AppSecret": "sandbox-bkash-app-secret",
      "Username": "sandbox-username",
      "Password": "sandbox-password",
      "BaseUrl": "https://tokenized.sandbox.bka.sh/v1.2.0-beta"
    },
    "SslCommerz": {
      "StoreId": "sandbox_store_id",
      "StorePassword": "sandbox_store_passwd",
      "IsSandbox": true,
      "BaseUrl": "https://sandbox.sslcommerz.com"
    }
  }
}
